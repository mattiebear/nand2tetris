// File name: projects/1/DMux4Way.hdl
/**
 * 4-way demultiplexor:
 * [a, b, c, d] = [in, 0, 0, 0] if sel = 00
 *                [0, in, 0, 0] if sel = 01
 *                [0, 0, in, 0] if sel = 10
 *                [0, 0, 0, in] if sel = 11
 */
CHIP DMux4Way {
    IN in, sel[2];
    OUT a, b, c, d;

    PARTS:
    Not(in=sel[0], out=notsa);
    Not(in=sel[1], out=notsb);

    And(a=notsa, b=notsb, out=anda);
    And(a=in, b=anda, out=a);

    And(a=in, b=sel[0], out=andb);
    And(a=notsb, b=andb, out=b);

    And(a=sel[1], b=notsa, out=andc);
    And(a=in, b=andc, out=c);

    And(a=sel[0], b=sel[1], out=andd);
    And(a=in, b=andd, out=d);
}